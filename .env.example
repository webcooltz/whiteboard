# Copy this file to .env and edit it. `npm run server` reads .env from the project folder,
# and the Raspberry Pi kiosk script (deploy/pi/kiosk.sh) reads one next to itself.
# Real environment variables override anything here. Quote values that contain spaces.

# The board password. The Pi signs in with it automatically; other devices enter it once
# (they stay signed in for 30 days) and after that only see the "your name" box.
BOARD_PASSWORD=change-me-to-something-long

PORT=8080

# Where the Pi kiosk opens the board. Same machine as the server: http://localhost:8080
WHITEBOARD_URL=http://localhost:8080

# Optional: the name a kiosk starts with. People can change it by clicking their name.
#WHITEBOARD_NAME=Kitchen

# Optional: a screen that only shows the board (ignores touches).
#READ_ONLY=1

# Optional: where boards, the audit log and the session secret are kept (default: ./data).
#DATA_DIR=/var/lib/whiteboard
