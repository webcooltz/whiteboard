# /etc/whiteboard.env  (chmod 600, owned by root)
PORT=8080
DATA_DIR=/var/lib/whiteboard

# Pick ONE way for people to sign in:
#  1) one shared password (people type their own name; names in the log are self-declared)
BOARD_PASSWORD=change-me-to-something-long
#  2) a password per person (names in the log are verified): leave BOARD_PASSWORD out and run
#       sudo -u whiteboard DATA_DIR=/var/lib/whiteboard node server/cli.mjs add-user Alice

# Wall displays / Raspberry Pis sign in with a device key instead of typing a password.
# Format: name=key,name=key   (each key at least 16 characters; generate with: openssl rand -hex 16)
BOARD_DEVICE_KEYS=pi-kitchen=replace-with-32-random-hex-chars

# Set to 1 only if the server sits behind a reverse proxy you control (Caddy, nginx, Tailscale serve).
# It makes the audit log record the real client address.
#TRUST_PROXY=1
